{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/webrtc/:path*",
      "destination": "https://api-crm.avigo.es/api/webrtc/:path*"
    },
    {
      "source": "/api/call/:path*",
      "destination": "https://api-crm.avigo.es/api/call/:path*"
    },
    {
      "source": "/api/calls/:path*",
      "destination": "https://api-crm.avigo.es/api/calls/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "http://avi-bot-avibotcitaplanner-khxi1c-391083-76-13-141-36.sslip.io/api/:path*"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
