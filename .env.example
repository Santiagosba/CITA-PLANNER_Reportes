# Opcional: subruta pública donde se monta la SPA (ej. /sb ). Vacío = raíz del dominio.
VITE_APP_BASE_PATH=

# URL del icono de la web Hub (equiv. hub_webs.icon_image_url). Si vacío → /avibot-logo.png.
VITE_HUB_WEB_ICON_URL=

# ── Backend / Hub (necesarios para login + selector real) ──
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# UUID operations.hub_webs.id para ESTE producto desplegado:
# VITE_HUB_WEB_ID=

# Nombre del producto (login, selector).
# VITE_APP_PRODUCT_NAME=
# VITE_APP_PRODUCT_ACCENT_LINE=
VITE_APP_LOGIN_SUBTITLE=Plantilla Hub — conecta backend, módulos y marca cuando definas el producto.
VITE_APP_SELECTOR_TAGLINE=Base lista: aquí engancharás datos, permisos y pantallas del siguiente proyecto.
VITE_APP_FOOTER_STAMP=BASE PLANTILLA

# ── Citas pendientes (SQL Server vía CitaplannerServer) ──
# Valores: supabase | sqlserver
VITE_PETICIONES_SOURCE=sqlserver
# Dev local: frontend :3001, API :3002 (proxy /api → 3002)
# VITE_DEV_PORT=3001
# VITE_API_PORT=3002
# En producción (Vercel): URL pública de la API (Dokploy, sin /api al final)
# VITE_SQL_API_URL=https://avi-bot-avibotcitaplanner-khxi1c-391083-76-13-141-36.sslip.io
# App del compañero (cuando esté lista sustituye la API local).
# Mismos endpoints: /api/peticiones-pendientes, /api/citas, /api/talleres…
# Mientras no esté, usamos CitaplannerServer + una copia local (localStorage).
# VITE_COLLEAGUE_API_URL=

# ── Softphone Telnyx (llamadas desde el CRM vía api-crm / CRM-API-main) ──
# URL pública de api-crm. El frontend pide ahí las credenciales SIP del operador
# (GET /api/webrtc/credentials), el número que ve el cliente (GET /api/call/outbound-cli)
# y registra cada llamada (POST /api/calls/log). Vacío = los botones «Llamar» usan tel:.
# api-crm debe incluir este origen en FRONTEND_ORIGIN (en local ya admite localhost).
# Grabación: la arranca api-crm sola al contestar (webhook Telnyx → /api/telnyx/webhooks)
#   y la guarda en Supabase Storage (SUPABASE_SERVICE_ROLE_KEY en api-crm).
# Transcripción en vivo: api-crm necesita STREAM_WS_URL (wss público) + DEEPGRAM_API_KEY;
#   el texto llega por Socket.io y se guarda en las notas de la llamada al colgar.
# Dev local (api-crm en :3000):
# VITE_CRM_API_URL=http://localhost:3000
# Producción:
# VITE_CRM_API_URL=https://api-crm.avigo.es

# ── Asesores de prueba (solo local) ──
# Cuentas REALES de Supabase Auth (ana.ruiz / luis.mora / carmen.vidal @taller.demo) con
# app_metadata.demo_asesor=true y membresía en operations.taller_users. El botón del login
# hace signInWithPassword con esta contraseña (pídesela al equipo; no la subas al repo).
# Sin definir → el login NO muestra asesores de prueba (así debe ir en producción).
# VITE_DEMO_ASESOR_PASSWORD=
