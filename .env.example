# Opcional: subruta pública donde se monta la SPA (ej. /sb ). Vacío = raíz del dominio.
VITE_APP_BASE_PATH=

# URL del icono de la web Hub (equiv. hub_webs.icon_image_url). Si vacío → /favicon.svg del proyecto.
VITE_HUB_WEB_ICON_URL=

# ── Backend / Hub (necesarios para login + selector real) ──
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# UUID operations.hub_webs.id para ESTE producto desplegado:
# VITE_HUB_WEB_ID=

# Nombre del producto (login, selector).
# VITE_APP_PRODUCT_NAME=
# VITE_APP_PRODUCT_ACCENT_LINE=
VITE_APP_LOGIN_SUBTITLE=Plantilla Hub — conecta backend, módulos y marca cuando definas el producto.
VITE_APP_SELECTOR_TAGLINE=Base lista: aquí engancharás datos, permisos y pantallas del siguiente proyecto.
VITE_APP_FOOTER_STAMP=BASE PLANTILLA

# ── Citas pendientes (SQL Server vía CitaplannerServer) ──
# Valores: supabase | sqlserver
VITE_PETICIONES_SOURCE=sqlserver
# En local (vacío): Vite proxy /api → localhost:3001 (CitaplannerServer)
# En producción (Vercel): URL pública de la API
# VITE_SQL_API_URL=https://tu-api.railway.app
