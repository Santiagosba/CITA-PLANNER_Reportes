# Opcional: subruta pública donde se monta la SPA (ej. /sb ). Vacío = raíz del dominio.
# Con base path vacío, un pathname de un solo segmento (que no sea ruta reservada) es el slug de taller
# en URL, ej. /mi-taller → carga `ui_branding` de ese taller. Slug válido: [a-z0-9_-]+ (véase `parseWorkshopSlugFromPathname` en src/lib/routePath.ts).
VITE_APP_BASE_PATH=

# URL del icono de la web Hub (equiv. hub_webs.icon_image_url). Si vacío → /favicon.svg del proyecto.
# En pantalla se usa tras el logo de licencia por slug; el favicon prioriza este env, luego hub_webs, luego logo de licencia.
VITE_HUB_WEB_ICON_URL=

# ── Backend / Hub (necesarios para login + selector real) ──
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# UUID operations.hub_webs.id para ESTE producto desplegado:
# VITE_HUB_WEB_ID=

# Nombre del producto (login, selector). Al descargar la plantilla desde Hub Connect se inyecta automáticamente.
# VITE_APP_PRODUCT_NAME=
# Línea opcional en color acento junto al nombre (ej. beta / línea comercial corta).
# VITE_APP_PRODUCT_ACCENT_LINE=
VITE_APP_LOGIN_SUBTITLE=Plantilla Hub — conecta backend, módulos y marca cuando definas el producto.
VITE_APP_SELECTOR_TAGLINE=Base lista: aquí engancharás datos, permisos y pantallas del siguiente proyecto.
VITE_APP_FOOTER_STAMP=BASE PLANTILLA

# ── SQL Server (citas pendientes en vivo) ──
# Valores: supabase | sqlserver
VITE_PETICIONES_SOURCE=sqlserver
# Vacío = usa proxy Vite /api → localhost:API_PORT en dev
# VITE_SQL_API_URL=

# Credenciales SQL Server (solo backend; NO uses prefijo VITE_)
# Pueden ir aquí o en server/.env (recomendado: server/.env)
# MSSQL_HOST=82.223.37.171
# MSSQL_PORT=1433
# MSSQL_DATABASE=CRMTaller
# MSSQL_USER=aviapi
# MSSQL_PASSWORD=
# API_PORT=3001
